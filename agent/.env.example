# ===================================================
# JANSEN TRANSPORTES - CONFIGURAÇÕES DO AGENTE DE IA
# Copie este arquivo para ".env" e preencha as chaves
# ===================================================

# Porta do Servidor Local/Nuvem
PORT=3001

# ===================================================
# 1. WHATSAPP BUSINESS CLOUD API OFICIAL DA META
# Gerado no portal: https://developers.facebook.com/
# ===================================================
# Token de Verificação do Webhook (Você escolhe a palavra-passe)
META_VERIFY_TOKEN=jansen_meta_token_secret

# Token de Acesso Permanente do Usuário de Sistema (Gerenciador de Negócios Meta)
META_ACCESS_TOKEN=seu_token_permanente_da_meta_aqui

# ID do Número de Telefone (Exibido no WhatsApp > Configuração da API)
META_PHONE_NUMBER_ID=seu_phone_number_id_aqui

# ===================================================
# 2. GOOGLE GEMINI API (LLM OFICIAL)
# Gerado gratuitamente no portal: https://aistudio.google.com/
# ===================================================
GEMINI_API_KEY=sua_chave_gemini_aqui

# Link Oficial do Google Meu Negócio para Avaliações 5 Estrelas
GOOGLE_REVIEW_LINK=https://g.page/r/jansen-transportes/review
